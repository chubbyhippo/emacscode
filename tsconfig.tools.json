{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "rootDir": ".",
    "outDir": ".build",
    "lib": ["ES2022"],
    "moduleDetection": "force",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts", "configure-manifest.ts", ".vscode-test.mts"]
}
