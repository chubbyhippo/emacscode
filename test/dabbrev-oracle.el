(require 'json)
(require 'dabbrev)
(let ((results nil) (dabbrev-check-other-buffers nil) (dabbrev-check-all-buffers nil))
  (dolist (case '(("alpha alpine al" 15 ("M-/" "M-/" "M-/"))
                  ("alphabet alpha AL" 17 ("M-/" "M-/" "M-/"))
                  ("ALPHA Albatross al" 18 ("M-/" "M-/"))
                  ("alpha beta al" 13 ("M-2 M-/"))
                  ("al alpha alpine" 2 ("M-- M-/" "M-/"))
                  ("nothing z" 9 ("M-/" "M-/"))
                  ("alpha alpine al" 15 ("M-0 M-/" "M-/"))
                  ("al alpha alpine" 2 ("M-0 M-/" "M-/"))
                  ("alpha al alpine" 8 ("M-0 M-/" "M-/"))
                  ("fooBar fo" 9 ("M-/" "M-/"))
                  ("FooBar F" 8 ("M-/" "M-/"))
                  ("fooBar foobar fo" 16 ("M-/" "M-/" "M-/"))
                  ("alpha al" 8 ("M-/" "M-2 M-/" "M-/"))))
    (with-temp-buffer
      (fundamental-mode)
      (transient-mark-mode 1)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (switch-to-buffer (current-buffer))
      (let ((last-command nil) (this-command nil) (entries nil))
        (dolist (sequence (nth 2 case))
          (let ((failure nil))
            (condition-case err
                (let ((this-command 'dabbrev-expand)
                      (current-prefix-arg (cond ((equal sequence "M-2 M-/") 2)
                                                ((equal sequence "M-0 M-/") 0)
                                                ((equal sequence "M-- M-/") -1)
                                                (t nil))))
                  (call-interactively 'dabbrev-expand)
                  (setq last-command 'dabbrev-expand))
              (error (setq failure (symbol-name (car err)) last-command nil)))
            (push `((sequence . ,sequence) (text . ,(buffer-string)) (point . ,(1- (point)))
                    (mark . ,(when (mark t) (1- (mark t)))) (active . ,(if mark-active t :json-false))
                    (error . ,failure)) entries)))
        (push `((input . ,(nth 0 case)) (start . ,(nth 1 case)) (steps . ,(vconcat (nreverse entries)))) results))))
  (princ (json-encode (nreverse results))))
