(require 'json)
(let ((results nil))
  (dolist (case '(("" 0 "C-f") ("" 0 "C-b")
                  ("abc" 3 "C-f") ("abc" 0 "C-b")
                  ("abc" 1 "M-2 C-f") ("abc" 1 "M-3 C-f")
                  ("abc" 2 "M-2 C-b") ("abc" 2 "M-3 C-b")
                  ("abc" 0 "M-0 C-b") ("abc" 3 "M-0 C-f")
                  ("abc" 1 "M-- M-2 C-f") ("abc" 2 "M-- M-2 C-b")
                  ("a\U0001f600b" 1 "M-2 C-f") ("a\U0001f600b" 1 "M-3 C-f")
                  ("a\U0001f600b" 2 "M-2 C-b") ("a\U0001f600b" 2 "M-3 C-b")))
    (with-temp-buffer
      (fundamental-mode)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (switch-to-buffer (current-buffer))
      (let ((failure nil) (last-command nil) (this-command nil))
        (condition-case error
            (execute-kbd-macro (kbd (nth 2 case)))
          (error (setq failure (symbol-name (car error)))))
        (push `((text . ,(vconcat (string-to-list (nth 0 case)))) (start . ,(nth 1 case))
                (keys . ,(nth 2 case)) (point . ,(1- (point))) (error . ,failure)) results))))
  (princ (json-encode (nreverse results))))
