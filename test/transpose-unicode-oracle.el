(require 'json)
(let ((results nil))
  (dolist (input '("a\U0001f600bcde" "a\U0001f600\nbcd" "ab\ne\u0301f"))
    (dolist (count '(1 2 -1 -2 0))
      (dotimes (mark-position (1+ (length input)))
        (dolist (active '(t nil))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char 4)
            (set-mark (1+ mark-position))
            (setq mark-active active)
            (switch-to-buffer (current-buffer))
            (let ((failure nil) (last-command nil) (this-command nil))
              (condition-case err
                  (execute-kbd-macro (kbd (format "M-%s C-t" count)))
                (error (setq failure (symbol-name (car err)))))
              (push `((input . ,(vconcat (string-to-list input)))
                      (count . ,count) (start . 3) (startMark . ,mark-position)
                      (startActive . ,(if active t :json-false))
                      (text . ,(vconcat (string-to-list (buffer-string))))
                      (point . ,(1- (point))) (mark . ,(when (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false)) (error . ,failure)) results)))))))
  (princ (json-encode (nreverse results))))
