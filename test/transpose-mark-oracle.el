(require 'json)
(let ((results nil))
  (dolist (count '(1 2 3 -1 -2 0))
    (dotimes (mark-position 7)
      (unless (and (= count 0) (memq mark-position '(3 6)))
        (dolist (active '(t nil))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert "abcdef")
            (goto-char 4)
            (set-mark (1+ mark-position))
            (setq mark-active active)
            (switch-to-buffer (current-buffer))
            (let ((failure nil) (last-command nil) (this-command nil))
              (condition-case err
                  (execute-kbd-macro (kbd (format "M-%s C-t" count)))
                (error (setq failure (symbol-name (car err)))))
              (push `((count . ,count) (startMark . ,mark-position)
                      (startActive . ,(if active t :json-false))
                      (text . ,(buffer-string)) (point . ,(1- (point)))
                      (mark . ,(when (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false))
                      (error . ,failure)) results)))))))
  (princ (json-encode (nreverse results))))
