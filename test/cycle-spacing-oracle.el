(require 'json)
(let ((results nil))
  (dolist (case '(("a \t  b" 3 "M-SPC") ("a \t  b" 3 "M-SPC M-SPC")
                  ("a \t  b" 3 "M-SPC M-SPC M-SPC")
                  ("a \t  b" 3 "M-SPC M-SPC M-SPC M-SPC")
                  ("ab" 1 "M-SPC M-SPC M-SPC")
                  ("a \t  b" 3 "M-3 M-SPC M-SPC")
                  ("a \t  b" 3 "M-3 M-SPC M-SPC M-SPC")
                  ("a \t  b" 3 "M-0 M-SPC M-SPC M-SPC")
                  ("a \n  b" 3 "M-- M-2 M-SPC M-SPC M-SPC")
                  ("a \n  b" 3 "M-- M-2 M-SPC")
                  ("a  b" 2 "M-3 M-SPC M-2 M-SPC")
                  ("a  b" 2 "M-SPC C-b M-SPC")
                  ("a  b" 2 "M-1 M-SPC M-SPC")
                  ("" 0 "M-SPC M-SPC M-SPC")))
    (with-temp-buffer
      (fundamental-mode)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (switch-to-buffer (current-buffer))
      (let ((last-command nil) (this-command nil) (cycle-spacing--context nil) (failure nil))
        (condition-case err
            (execute-kbd-macro (kbd (nth 2 case)))
          (error (setq failure (symbol-name (car err)))))
        (push `((input . ,(nth 0 case)) (start . ,(nth 1 case)) (keys . ,(nth 2 case))
                (text . ,(buffer-string)) (point . ,(1- (point))) (error . ,failure)) results))))
  (princ (json-encode (nreverse results))))
