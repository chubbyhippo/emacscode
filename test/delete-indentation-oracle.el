(require 'json)
(let ((results nil))
  (dolist (input '("" "abc" "one\ntwo" "one  \n  two\nthree" "(\n x\n)" "x,\n y" "\n a\n" "a\n\n b" "a\U0001f600\n e\u0301"))
    (dotimes (start (1+ (length input)))
      (dolist (kind '(unset inactive active))
        (dolist (prefix '(nil t))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char (1+ start))
            (unless (eq kind 'unset)
              (set-mark (point-max))
              (setq mark-active (eq kind 'active)))
            (switch-to-buffer (current-buffer))
            (let ((failure nil) (last-command nil) (this-command nil))
              (condition-case err
                  (execute-kbd-macro (kbd (if prefix "M-0 M-^" "M-^")))
                (error (setq failure (symbol-name (car err)))))
              (push `((input . ,(vconcat (string-to-list input))) (start . ,start)
                      (initial . ,(symbol-name kind)) (prefix . ,(if prefix t :json-false))
                      (text . ,(vconcat (string-to-list (buffer-string)))) (point . ,(1- (point)))
                      (mark . ,(when (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false)) (error . ,failure)) results)))))))
  (princ (json-encode (nreverse results))))
