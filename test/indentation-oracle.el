(require 'json)
(let ((results nil))
  (dolist (case '(("  alpha" 0 "M-m") ("  alpha" 5 "M-m M-m")
                  ("\t  alpha\n  beta" 12 "M-m") ("one\n  \ntwo" 4 "M-m")
                  ("one\n\ntwo" 4 "M-m") ("  first\n    second" 15 "C-u 3 M-m")
                  ("plain" 5 "M-m") ("  " 2 "M-m")))
    (with-temp-buffer
      (fundamental-mode)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (switch-to-buffer (current-buffer))
      (execute-kbd-macro (kbd (nth 2 case)))
      (push `((input . ,(nth 0 case)) (start . ,(nth 1 case)) (keys . ,(nth 2 case))
              (point . ,(1- (point))) (text . ,(buffer-string))) results)))
  (princ (json-encode (nreverse results))))
