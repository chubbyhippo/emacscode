(require 'json)
(let ((results nil))
  (dolist (text '("" "abc" "a  b" "\t ab\nxyz" "a\tb" "    "))
    (dotimes (start (1+ (length text)))
      (dolist (mark-state '(unset inactive active))
        (dolist (mark-position (if (eq mark-state 'unset) '(0) (list 0 start (length text))))
          (dolist (tab-size '(4 8))
            (dolist (insert-tabs '(nil t))
              (dolist (key '("M-i" "M-0 M-i" "M-- M-i" "C-u M-i"))
                (with-temp-buffer
                  (fundamental-mode)
                  (setq-local tab-width tab-size indent-tabs-mode insert-tabs tab-stop-list nil)
                  (transient-mark-mode 1)
                  (insert text)
                  (goto-char (1+ start))
                  (unless (eq mark-state 'unset)
                    (set-mark (1+ mark-position))
                    (setq mark-active (eq mark-state 'active)))
                  (switch-to-buffer (current-buffer))
                  (let ((failure nil) (last-command nil) (this-command nil))
                    (condition-case err (execute-kbd-macro (kbd key)) (error (setq failure (symbol-name (car err)))))
                    (push `((text . ,text) (start . ,start) (markState . ,(symbol-name mark-state))
                            (markPosition . ,mark-position) (tabSize . ,tab-size) (insertTabs . ,(if insert-tabs t :json-false))
                            (key . ,key) (output . ,(buffer-string)) (point . ,(1- (point)))
                            (mark . ,(and (mark t) (1- (mark t))))
                            (active . ,(if mark-active t :json-false)) (error . ,failure)) results))))))))))
  (princ (json-encode (nreverse results))))
