(require 'json)
(let ((results nil)
      (texts '("ab\tcd\n0123456789ab\n\tx\nabcdefghijkl" "0123456789\n\txyz\nabc\nabcdefghijk" "x\tq\nq\tx\nz\nabcdefghij")))
  (dolist (text texts)
    (dolist (tab-size '(4 8))
      (dotimes (start (1+ (length text)))
        (dolist (keys '("C-n" "C-p" "C-n C-n" "C-p C-p" "C-n C-p" "C-p C-n"))
          (with-temp-buffer
            (fundamental-mode)
            (setq-local tab-width tab-size)
            (setq-local line-move-visual nil)
            (transient-mark-mode 1)
            (insert text)
            (goto-char (1+ start))
            (set-mark (point))
            (switch-to-buffer (current-buffer))
            (let ((failed nil) (last-command nil) (this-command nil))
              (condition-case nil (execute-kbd-macro (kbd keys)) (error (setq failed t)))
              (push `((text . ,text) (tabSize . ,tab-size) (start . ,start) (keys . ,keys)
                      (point . ,(1- (point))) (mark . ,(1- (mark t)))
                      (active . ,(if mark-active t :json-false)) (failed . ,(if failed t :json-false))) results)))))))
  (princ (json-encode (nreverse results))))
