(require 'json)
(require 'misc)
(let (results)
  (dolist (keys '("M-z z" "M-3 M-z a" "M-- M-z z"))
    (dolist (mark-state '(unset active inactive))
      (with-temp-buffer
        (fundamental-mode)
        (transient-mark-mode 1)
        (insert "alpha beta")
        (goto-char 3)
        (unless (eq mark-state 'unset)
          (set-mark 1)
          (setq mark-active (eq mark-state 'active)))
        (switch-to-buffer (current-buffer))
        (let ((kill-ring '("older")) (kill-ring-yank-pointer nil)
              (interprogram-cut-function nil) (interprogram-paste-function nil)
              (last-command nil) (this-command nil) (failed nil))
          (setq kill-ring-yank-pointer kill-ring)
          (condition-case nil (execute-kbd-macro (kbd keys)) (error (setq failed t)))
          (push `((keys . ,keys) (markState . ,(symbol-name mark-state))
                  (text . ,(buffer-string)) (point . ,(1- (point)))
                  (mark . ,(and (mark t) (1- (mark t))))
                  (active . ,(if mark-active t :json-false))
                  (ring . ,(vconcat kill-ring)) (failed . ,(if failed t :json-false))) results)))))
  (princ (json-encode (nreverse results))))
