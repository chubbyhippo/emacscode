(require 'json)
(let ((results nil))
  (dolist (input '("" "abc" "one\nline\n\ntwo\n\nthree" "\n \t\nfirst\n\n\nsecond\n" "a\U0001f600\n\ne\u0301\nx"))
    (dotimes (start (1+ (length input)))
      (dolist (initial '(unset inactive active))
        (dolist (count '(-2 -1 0 1 2))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char (1+ start))
            (unless (eq initial 'unset)
              (set-mark (point-max))
              (setq mark-active (eq initial 'active)))
            (switch-to-buffer (current-buffer))
            (let ((failure nil) (last-command nil) (this-command nil))
              (condition-case err
                  (execute-kbd-macro (kbd (format "M-%s M-h" count)))
                (error (setq failure (symbol-name (car err)))))
              (push `((input . ,(vconcat (string-to-list input)))
                      (start . ,start) (count . ,count) (initial . ,(symbol-name initial))
                      (point . ,(1- (point))) (mark . ,(when (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false)) (error . ,failure)) results)))))))
  (princ (json-encode (nreverse results))))
