(require 'json)
(let ((results nil)
      (text (mapconcat (lambda (_) "abcdefghijklmnopqrstuvwxyz0123456789") (number-sequence 1 16) "\n")))
  (dolist (case '(("n" 1 15) ("p" 13 15) ("f" 1 15) ("b" 1 15)))
    (with-temp-buffer
      (fundamental-mode)
      (insert text)
      (goto-char (point-min))
      (forward-line (nth 1 case))
      (move-to-column (nth 2 case))
      (switch-to-buffer (current-buffer))
      (execute-kbd-macro (kbd (concat "C-u C-1 C-2 C-" (car case))))
      (let ((first (point)))
        (execute-kbd-macro (kbd (concat "C-" (car case))))
        (push `((key . ,(car case)) (first . ,first) (second . ,(point))) results))))
  (princ (json-encode (nreverse results))))
