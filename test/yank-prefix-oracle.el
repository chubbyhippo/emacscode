(require 'json)
(let (results)
  (dolist (keys '("C-y" "C-u C-y" "C-u C-u C-y" "M-0 C-y" "M-1 C-y" "M-2 C-y" "M-3 C-y" "M-4 C-y" "M-- C-y" "M-- M-2 C-y" "C-u C-y M-y" "M-2 C-y M-y" "M-0 C-y M-- M-2 M-y"))
    (dolist (start '(0 1 2))
      (dolist (marked '(nil active inactive))
        (with-temp-buffer
          (fundamental-mode)
          (transient-mark-mode 1)
          (insert "xy")
          (goto-char (1+ start))
          (when marked (set-mark 1) (setq mark-active (eq marked 'active)))
          (switch-to-buffer (current-buffer))
          (let ((kill-ring '("new" "middle" "old"))
                (interprogram-cut-function nil) (interprogram-paste-function nil)
                (last-command nil) (this-command nil) (failed nil))
            (setq kill-ring-yank-pointer kill-ring)
            (condition-case nil (execute-kbd-macro (kbd keys)) (error (setq failed t)))
            (push `((keys . ,keys) (start . ,start) (marked . ,(if marked (symbol-name marked) "unset"))
                    (text . ,(buffer-string)) (point . ,(1- (point)))
                    (mark . ,(and (mark t) (1- (mark t))))
                    (active . ,(if mark-active t :json-false)) (current . ,(car kill-ring-yank-pointer))
                    (failed . ,(if failed t :json-false))) results))))))
  (princ (json-encode (nreverse results))))
