(require 'json)
(put 'set-goal-column 'disabled nil)
(let ((results nil))
  (dolist (input '("abcde\nx\n0123456789\nend" "a\tb\nshort\n0123456789"))
    (dotimes (start (1+ (length input)))
      (unless (eq (aref (concat input "\0") start) ?\n)
        (dolist (clear '(nil t))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (setq-local line-move-visual nil tab-width 4)
            (insert input)
            (goto-char (1+ start))
            (set-mark (point))
            (setq mark-active t)
            (switch-to-buffer (current-buffer))
            (let ((last-command nil) (this-command nil) (failure nil))
              (condition-case err
                  (execute-kbd-macro (kbd (if clear "C-x C-n M-0 C-x C-n C-n" "C-x C-n C-a C-n")))
                (error (setq failure (symbol-name (car err)))))
              (push `((input . ,input) (start . ,start) (clear . ,(if clear t :json-false))
                      (point . ,(1- (point))) (mark . ,(1- (mark t)))
                      (active . ,(if mark-active t :json-false)) (goal . ,goal-column)
                      (error . ,failure)) results)))))))
  (princ (json-encode (nreverse results))))
