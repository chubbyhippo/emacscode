(require 'json)
(let ((results nil))
  (dolist (input '("one (two [three]) end" "alpha beta" "(a) (b)" "one \"two words\" three" "abc   " "\\( x" "(a)"))
    (dolist (kind '(sexp list down up))
      (dotimes (start (1+ (length input)))
        (dolist (count '(-2 -1 0 1 2))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char (1+ start))
            (set-mark (point))
            (setq mark-active t)
            (let ((failure nil))
              (condition-case nil
                  (pcase kind
                    ('sexp (forward-sexp count))
                    ('list (forward-list count))
                    ('down (down-list count))
                    ('up (backward-up-list count)))
                (error (setq failure t)))
              (push `((input . ,input) (start . ,start) (kind . ,(symbol-name kind))
                      (count . ,count) (point . ,(1- (point)))
                      (failed . ,(if failure t :json-false))) results)))))))
  (princ (json-encode (nreverse results))))
