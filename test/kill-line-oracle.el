(require 'json)
(let ((results nil))
  (dolist (case '(("abc\ndef\nghi" 1 "C-k") ("abc\ndef\nghi" 1 "C-u 1 C-k")
                  ("abc\ndef\nghi" 1 "C-u 2 C-k") ("abc\ndef\nghi" 5 "M-- C-k")
                  ("abc\ndef\nghi" 5 "M-0 C-k") ("abc  \ndef" 3 "C-k")
                  ("abc\ndef" 3 "C-k") ("abc\ndef" 7 "C-k")
                  ("\nabc" 0 "M-0 C-k") ("abc\ndef" 5 "M-- M-2 C-k")
                  ("abc\ndef" 6 "C-u 4 C-k")))
    (with-temp-buffer
      (fundamental-mode)
      (setq-local kill-ring nil)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (switch-to-buffer (current-buffer))
      (let ((failed nil))
        (condition-case nil (execute-kbd-macro (kbd (nth 2 case))) (error (setq failed t)))
        (push `((input . ,(nth 0 case)) (start . ,(nth 1 case)) (keys . ,(nth 2 case))
                (text . ,(buffer-string)) (point . ,(1- (point))) (kill . ,(car kill-ring))
                (ring . ,(vconcat kill-ring)) (failed . ,(if failed t :json-false))) results))))
  (princ (json-encode (nreverse results))))
