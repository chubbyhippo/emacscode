(require 'json)
(let ((results nil))
  (dolist (case '(("aa\nbb\ncc" 4 "C-a") ("aa\nbb\ncc" 4 "C-e")
                  ("aa\nbb\ncc" 4 "M-0 C-a") ("aa\nbb\ncc" 4 "M-0 C-e")
                  ("aa\nbb\ncc" 4 "M-2 C-a") ("aa\nbb\ncc" 4 "M-2 C-e")
                  ("aa\nbb\ncc" 4 "M-- M-2 C-a") ("aa\nbb\ncc" 4 "M-- M-2 C-e")
                  ("aa\nbb\ncc" 4 "M-9 C-a") ("aa\nbb\ncc" 4 "M-9 C-e")
                  ("\nbb\n" 1 "M-0 C-a") ("\nbb\n" 1 "M-0 C-e")
                  ("aa\nbb\n" 5 "M-2 C-a") ("aa\nbb\n" 5 "M-2 C-e")))
    (with-temp-buffer
      (fundamental-mode)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (switch-to-buffer (current-buffer))
      (let ((failed nil) (last-command nil) (this-command nil))
        (condition-case nil (execute-kbd-macro (kbd (nth 2 case))) (error (setq failed t)))
        (push `((text . ,(nth 0 case)) (start . ,(nth 1 case)) (keys . ,(nth 2 case))
                (point . ,(1- (point))) (failed . ,(if failed t :json-false))) results))))
  (princ (json-encode (nreverse results))))
