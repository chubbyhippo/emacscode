(require 'json)
(let ((results nil))
  (dolist (mark-state '(unset inactive active))
    (dolist (position '(0 3 6))
      (dolist (key '("C-x C-x" "C-u C-x C-x" "M-0 C-x C-x" "M-2 C-x C-x" "M-- C-x C-x"))
        (with-temp-buffer
          (fundamental-mode)
          (transient-mark-mode 1)
          (insert "abcdef")
          (goto-char (1+ position))
          (unless (eq mark-state 'unset)
            (set-mark 3)
            (setq mark-active (eq mark-state 'active)))
          (switch-to-buffer (current-buffer))
          (let ((failed nil) (last-command nil) (this-command nil))
            (condition-case nil (execute-kbd-macro (kbd key)) (error (setq failed t)))
            (push `((initialPoint . ,position) (markState . ,(symbol-name mark-state)) (key . ,key)
                    (point . ,(1- (point))) (mark . ,(and (mark t) (1- (mark t))))
                    (active . ,(if mark-active t :json-false)) (failed . ,(if failed t :json-false))) results))))))
  (princ (json-encode (nreverse results))))
