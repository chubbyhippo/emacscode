(require 'json)
(let ((results nil))
  (dolist (input '("" "abc" "a \t b" " a\n \tb " "\U0001f600  \u732b" "a\u00a0 b"))
    (dotimes (start (1+ (length input)))
      (dolist (mark-state '(unset active inactive))
        (dolist (mark-position (if (eq mark-state 'unset) '(nil) (delete-dups (list 0 start (length input)))))
          (dolist (prefix '("" "C-u " "M-0 " "M-- M-2 " "C-u C-u "))
            (with-temp-buffer
              (fundamental-mode)
              (transient-mark-mode 1)
              (insert input)
              (goto-char (1+ start))
              (unless (eq mark-state 'unset)
                (set-mark (1+ mark-position))
                (setq mark-active (eq mark-state 'active)))
              (switch-to-buffer (current-buffer))
              (let ((failed nil))
                (condition-case nil
                    (execute-kbd-macro (kbd (concat prefix "M-\\")))
                  (error (setq failed t)))
                (push `((input . ,(vconcat (string-to-list input))) (start . ,start) (markState . ,(symbol-name mark-state))
                        (initialMark . ,mark-position) (prefix . ,prefix)
                        (text . ,(vconcat (string-to-list (buffer-string)))) (point . ,(1- (point)))
                        (mark . ,(and (mark t) (1- (mark t))))
                        (active . ,(if mark-active t :json-false))
                        (failed . ,(if failed t :json-false))) results))))))))
  (princ (json-encode (nreverse results))))
