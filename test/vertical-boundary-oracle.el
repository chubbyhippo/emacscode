(require 'json)
(let ((results nil))
  (dolist (text '("" "abc" "abc\n" "abc\nx\nabcdef" "\nabc\n"))
    (dotimes (start (1+ (length text)))
      (dolist (key '("C-n" "C-p" "M-0 C-n" "M-2 C-n" "M-2 C-p" "M-- C-n" "M-- C-p" "M-- M-2 C-n" "M-- M-2 C-p"))
        (with-temp-buffer
          (fundamental-mode)
          (setq-local line-move-visual nil)
          (transient-mark-mode 1)
          (insert text)
          (goto-char (1+ start))
          (set-mark (point))
          (switch-to-buffer (current-buffer))
          (let ((failure nil) (last-command nil) (this-command nil))
            (condition-case err (execute-kbd-macro (kbd key)) (error (setq failure (symbol-name (car err)))))
            (let ((first (1- (point))) (first-mark (1- (mark t))) (first-active mark-active) (recovery nil))
              (when failure
                (condition-case nil
                    (execute-kbd-macro (kbd (if (string= failure "end-of-buffer") "C-p" "C-n")))
                  (error nil))
                (setq recovery (1- (point))))
              (push `((text . ,text) (start . ,start) (key . ,key) (point . ,first)
                      (mark . ,first-mark) (active . ,(if first-active t :json-false))
                      (error . ,failure) (recovery . ,recovery)) results)))))))
  (princ (json-encode (nreverse results))))
