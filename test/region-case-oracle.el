(require 'json)
(put 'upcase-region 'disabled nil)
(put 'downcase-region 'disabled nil)
(let (results)
  (dolist (input '("" "abc XYZ" "One\ntWo" "123 !"))
    (dotimes (start (1+ (length input)))
      (dotimes (mark (1+ (length input)))
        (dolist (kind '(upcase downcase))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char (1+ start))
            (set-mark (1+ mark))
            (setq mark-active t)
            (switch-to-buffer (current-buffer))
            (let ((last-command nil) (this-command nil) (failure nil))
              (condition-case err
                  (execute-kbd-macro (kbd (if (eq kind 'upcase) "C-x C-u" "C-x C-l")))
                (error (setq failure (symbol-name (car err)))))
              (push `((input . ,input) (start . ,start) (mark-start . ,mark)
                      (kind . ,(symbol-name kind)) (text . ,(buffer-string))
                      (point . ,(1- (point))) (mark . ,(when (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false)) (error . ,failure)) results)))))))
  (princ (json-encode (nreverse results))))
