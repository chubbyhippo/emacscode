(require 'json)
(let (results)
  (dolist (case '(("kill" "one (two) three" 0 1) ("kill" "one (two) three" 4 1)
                  ("kill" "one (two) three" 9 -1) ("kill" "one (two) three" 0 0)
                  ("mark" "one (two) three" 0 1) ("mark" "one (two) three" 4 1)
                  ("mark" "one (two) three" 9 -1) ("mark" "one (two) three" 0 0)
                  ("transpose" "one two" 3 1) ("transpose" "(one) (two)" 5 1)
                  ("transpose" "one two three" 7 1)))
    (with-temp-buffer
      (fundamental-mode)
      (transient-mark-mode 1)
      (insert (nth 1 case))
      (goto-char (1+ (nth 2 case)))
      (setq kill-ring nil mark-active nil)
      (switch-to-buffer (current-buffer))
      (let ((last-command nil) (this-command nil) (failure nil))
        (condition-case err
            (execute-kbd-macro (kbd (format "M-%s %s" (nth 3 case)
              (cond ((equal (car case) "kill") "C-M-k")
                    ((equal (car case) "mark") "C-M-@")
                    (t "C-M-t")))))
          (error (setq failure (symbol-name (car err)))))
        (push `((kind . ,(car case)) (input . ,(nth 1 case)) (start . ,(nth 2 case))
                (count . ,(nth 3 case)) (text . ,(buffer-string)) (point . ,(1- (point)))
                (mark . ,(when (mark t) (1- (mark t)))) (active . ,(if mark-active t :json-false))
                (ring . ,(vconcat kill-ring)) (error . ,failure)) results))))
  (princ (json-encode (nreverse results))))
