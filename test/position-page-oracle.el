(require 'json)
(require 'page)
(let (results)
  (dolist (input '("" "abc" "a😀\nb" "one\n\fpage\nxx\n\fnext" "\f\f\nend"))
    (dotimes (start (1+ (length input)))
      (dolist (kind '(character page column))
        (dolist (count '(-2 -1 0 1 2 4 9 40))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char (1+ start))
            (set-mark (point-max))
            (setq mark-active t)
            (condition-case nil
                (pcase kind
                  ('character (goto-char count))
                  ('page (forward-page count))
                  ('column (move-to-column count)))
              (error nil))
            (push `((input . ,(vconcat (string-to-list input)))
                    (start . ,start) (kind . ,(symbol-name kind)) (count . ,count)
                    (point . ,(1- (point))) (mark . ,(1- (mark t)))
                    (active . ,(if mark-active t :json-false))) results))))))
  (princ (json-encode (nreverse results))))
