(require 'json)
(let ((results nil)
      (interprogram-cut-function nil)
      (interprogram-paste-function nil)
      (select-enable-clipboard nil)
      (select-enable-primary nil))
  (dolist (case '(("unset-kill" nil 0 "C-w") ("unset-copy" nil 0 "M-w")
                  ("empty-kill" 0 0 "C-w") ("empty-copy" 0 0 "M-w")
                  ("inactive-kill" 0 5 "C-w") ("inactive-copy" 0 5 "M-w")
                  ("forward-kill" 0 5 "C-w") ("reverse-kill" 5 0 "C-w")
                  ("forward-copy" 0 5 "M-w") ("reverse-copy" 5 0 "M-w")))
    (with-temp-buffer
      (fundamental-mode)
      (transient-mark-mode 1)
      (insert "alpha beta")
      (goto-char (1+ (nth 2 case)))
      (when (nth 1 case) (set-mark (1+ (nth 1 case))) (setq mark-active (not (string-prefix-p "inactive-" (car case)))))
      (setq-local kill-ring (list "older"))
      (setq-local kill-ring-yank-pointer kill-ring)
      (switch-to-buffer (current-buffer))
      (let ((failed nil) (last-command nil) (this-command nil))
        (condition-case nil (execute-kbd-macro (kbd (nth 3 case))) (error (setq failed t)))
        (push `((name . ,(nth 0 case)) (text . ,(buffer-string)) (point . ,(1- (point)))
                (mark . ,(and (mark t) (1- (mark t))))
                (active . ,(if mark-active t :json-false)) (failed . ,(if failed t :json-false))
                (ring . ,(vconcat kill-ring))) results))))
  (princ (json-encode (nreverse results))))
