(require 'json)
(let ((results nil))
  (dolist (input '("" "a" "a\n" "a\nb" "a\nb\n" "ab\nc\ndef\n" "a\n\nb\n"))
    (dotimes (start (1+ (length input)))
      (dolist (count '(-3 -2 -1 0 1 2 3))
        (dolist (mark-state '(unset active inactive active-start inactive-start))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char (1+ start))
            (unless (eq mark-state 'unset)
              (set-mark (if (memq mark-state '(active-start inactive-start)) (point-min) (point-max)))
              (setq mark-active (memq mark-state '(active active-start))))
            (switch-to-buffer (current-buffer))
            (let ((failure nil) (last-command nil) (this-command nil))
              (condition-case err
                  (execute-kbd-macro (kbd (format "M-%s C-x C-t" count)))
                (error (setq failure (symbol-name (car err)))))
              (push `((input . ,input) (start . ,start) (count . ,count)
                      (initial . ,(symbol-name mark-state)) (text . ,(buffer-string))
                      (point . ,(1- (point))) (mark . ,(when (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false)) (error . ,failure)) results)))))))
  (princ (json-encode (nreverse results))))
