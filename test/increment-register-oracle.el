(require 'json)
(require 'register)
(let (results)
  (dolist (kind '(empty text number rectangle))
    (dolist (region '(forward reverse empty unset inactive))
      (dolist (prefix '("" "C-u " "M-0 " "M-- M-2 "))
        (with-temp-buffer
          (fundamental-mode)
          (transient-mark-mode 1)
          (insert "abcdef")
          (let ((register-alist nil) (last-command nil) (this-command nil) (failed nil))
            (pcase kind
              ('text (set-register ?r "old"))
              ('number (set-register ?r 7))
              ('rectangle (set-register ?r '("a" "b"))))
            (goto-char (if (eq region 'reverse) 2 5))
            (unless (eq region 'unset)
              (set-mark (if (eq region 'empty) (point) (if (eq region 'reverse) 5 2)))
              (setq mark-active (not (eq region 'inactive))))
            (switch-to-buffer (current-buffer))
            (condition-case nil
                (execute-kbd-macro (kbd (concat prefix "C-x r + r")))
              (error (setq failed t)))
            (let ((value (get-register ?r)))
              (push `((kind . ,(symbol-name kind)) (region . ,(symbol-name region))
                      (prefix . ,prefix) (text . ,(buffer-string))
                      (point . ,(1- (point))) (mark . ,(and (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false))
                      (failed . ,(if failed t :json-false))
                      (value . ,(if (listp value) (and value (vconcat value)) value))) results)))))))
  (princ (json-encode (nreverse results))))
