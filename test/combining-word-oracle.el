(require 'json)
(let ((results nil)
      (interprogram-cut-function nil)
      (interprogram-paste-function nil))
  (dolist (case '(("e\u0301COLE fin" 0 "M-f") ("e\u0301COLE fin" 6 "M-b")
                  ("e\u0301COLE fin" 0 "M-d") ("e\u0301COLE fin" 0 "M-c")
                  ("e\u0301COLE fin" 1 "M-f") ("e\u0301COLE fin" 1 "M-c")
                  ("\u0915\u093f fin" 0 "M-f") ("\u0915\u093f fin" 2 "M-b")))
    (with-temp-buffer
      (fundamental-mode)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (setq-local kill-ring nil)
      (switch-to-buffer (current-buffer))
      (let ((failed nil) (last-command nil) (this-command nil))
        (condition-case nil (execute-kbd-macro (kbd (nth 2 case))) (error (setq failed t)))
        (push `((input . ,(vconcat (string-to-list (nth 0 case)))) (start . ,(nth 1 case))
                (keys . ,(nth 2 case)) (text . ,(vconcat (string-to-list (buffer-string))))
                (point . ,(1- (point))) (ring . ,(vconcat (mapcar (lambda (value) (vconcat (string-to-list value))) kill-ring)))
                (failed . ,(if failed t :json-false))) results))))
  (princ (json-encode (nreverse results))))
