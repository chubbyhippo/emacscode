(require 'json)
(let (results)
  (dolist (input '("" "one (two) x" "(a" "a) b" "a\nb"))
    (dotimes (start (1+ (length input)))
      (dolist (count '(-2 -1 0 1 2))
        (with-temp-buffer
          (fundamental-mode)
          (transient-mark-mode 1)
          (setq-local kill-ring '("older"))
          (insert input)
          (goto-char (1+ start))
          (set-mark (point))
          (setq mark-active t)
          (switch-to-buffer (current-buffer))
          (let ((failure nil) (last-command nil) (this-command nil))
            (condition-case nil
                (execute-kbd-macro (kbd (format "M-%s C-M-k" count)))
              (error (setq failure t)))
            (push `((input . ,input) (start . ,start) (count . ,count)
                    (text . ,(buffer-string)) (point . ,(1- (point)))
                    (mark . ,(when (mark t) (1- (mark t))))
                    (active . ,(if mark-active t :json-false))
                    (failed . ,(if failure t :json-false))
                    (ring . ,(vconcat kill-ring))) results))))))
  (dolist (input '("one ) two" "one (two"))
    (with-temp-buffer
      (fundamental-mode)
      (transient-mark-mode 1)
      (setq-local kill-ring '("older"))
      (insert input)
      (goto-char 1)
      (switch-to-buffer (current-buffer))
      (let ((last-command nil) (this-command nil) (failed nil))
        (execute-kbd-macro (kbd "C-M-k"))
        (condition-case nil (execute-kbd-macro (kbd "C-M-k"))
          (error (setq failed t)))
        (let ((failure-point (1- (point))) (failure-text (buffer-string))
              (failure-ring (vconcat kill-ring)))
          (execute-kbd-macro (kbd "M-d"))
          (push `((input . ,input) (sequence . "failure-recovery")
                  (failurePoint . ,failure-point) (failureText . ,failure-text)
                  (failureRing . ,failure-ring) (failed . ,(if failed t :json-false))
                  (text . ,(buffer-string)) (point . ,(1- (point)))
                  (ring . ,(vconcat kill-ring))) results)))))
  (princ (json-encode (nreverse results))))
