(require 'json)
(let ((results nil))
  (dolist (input '("one  two three" "one\ntwo three" "one.  Two three" "one two\n\nthree  four five" "  one two three" ""))
    (dotimes (start (1+ (length input)))
      (dolist (width '(8 12 70))
        (dolist (mark-state '(unset inactive active))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (setq-local fill-column width)
            (insert input)
            (goto-char (1+ start))
            (unless (eq mark-state 'unset)
              (set-mark (point-min))
              (setq mark-active (eq mark-state 'active)))
            (switch-to-buffer (current-buffer))
            (let ((failure nil) (last-command nil) (this-command nil))
              (condition-case err
                  (execute-kbd-macro (kbd "M-q"))
                (error (setq failure (symbol-name (car err)))))
              (push `((input . ,input) (start . ,start) (width . ,width)
                      (initial . ,(symbol-name mark-state)) (text . ,(buffer-string))
                      (point . ,(1- (point))) (mark . ,(when (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false)) (error . ,failure)) results)))))))
  (princ (json-encode (nreverse results))))
