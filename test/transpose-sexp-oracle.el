(require 'json)
(let (results)
  (dolist (input '("" "one" "one two three" "a (bb) c" "one\ntwo"))
    (dotimes (start (1+ (length input)))
      (dolist (count '(-2 -1 0 1 2))
        (dolist (mark-state '(unset active-start active-end inactive-start inactive-end))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char (1+ start))
            (unless (eq mark-state 'unset)
              (set-mark (if (memq mark-state '(active-end inactive-end)) (point-max) (point-min)))
              (setq mark-active (memq mark-state '(active-start active-end))))
            (switch-to-buffer (current-buffer))
            (let ((last-command nil) (this-command nil) (failed nil)
                  (kill-ring '("sentinel")) (interprogram-cut-function nil)
                  (interprogram-paste-function nil))
              (condition-case nil
                  (execute-kbd-macro (kbd (format "M-%s C-M-t" count)))
                (error (setq failed t)))
              (push `((input . ,input) (start . ,start) (count . ,count)
                      (initial . ,(symbol-name mark-state)) (text . ,(buffer-string))
                      (point . ,(1- (point))) (mark . ,(when (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false))
                      (failed . ,(if failed t :json-false)) (ring . ,(vconcat kill-ring))) results)))))))
  (princ (json-encode (nreverse results))))
