(require 'json)
(let ((results nil))
  (dolist (case '(("left   right" 6 "M-\\") ("left   right" 6 "C-u 1 M-\\")
                  ("left\t  right" 7 "C-u 0 M-\\") ("left  \n  right" 6 "M-\\")
                  ("   text" 0 "M-\\") ("text   " 7 "M-\\")))
    (with-temp-buffer
      (fundamental-mode)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (switch-to-buffer (current-buffer))
      (execute-kbd-macro (kbd (nth 2 case)))
      (push `((input . ,(nth 0 case)) (start . ,(nth 1 case)) (keys . ,(nth 2 case))
              (text . ,(buffer-string)) (point . ,(1- (point)))) results)))
  (princ (json-encode (nreverse results))))
