(require 'json)
(let ((results nil))
  (dolist (input '("" "alpha" "One.  Two!  Three?" "One. Two.\nNext" "a\n\nb\n" "😀終。次.  End"))
    (dotimes (start (1+ (length input)))
      (dolist (count '(-2 -1 0 1 2))
        (dolist (key '("M-k" "C-x DEL"))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (setq-local kill-ring '("older"))
            (insert input)
            (goto-char (1+ start))
            (set-mark (point))
            (setq mark-active t)
            (switch-to-buffer (current-buffer))
            (let ((failure nil) (last-command nil) (this-command nil))
              (condition-case err
                  (execute-kbd-macro (kbd (format "M-%s %s" count key)))
                (error (setq failure (symbol-name (car err)))))
              (push `((input . ,(vconcat (string-to-list input)))
                      (start . ,start) (count . ,count) (key . ,key)
                      (text . ,(vconcat (string-to-list (buffer-string))))
                      (point . ,(1- (point))) (mark . ,(1- (mark t)))
                      (active . ,(if mark-active t :json-false))
                      (ring . ,(vconcat (mapcar (lambda (value) (vconcat (string-to-list value))) kill-ring)))
                      (error . ,failure)) results)))))))
  (dolist (case '(("One.  Two!  Three?" 0 "M-k M-k")
                  ("One.  Two!  Three?" 18 "C-x DEL C-x DEL")
                  ("One.  Two!  Three?" 0 "M-d M-k")
                  ("One.  Two!  Three?" 0 "M-0 M-k M-k")
                  ("One.  Two!  Three?" 0 "M-k C-y")
                  ("One.  Two!  Three?" 18 "C-x DEL C-y")))
    (with-temp-buffer
      (fundamental-mode)
      (transient-mark-mode 1)
      (setq-local kill-ring '("older"))
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (set-mark (point))
      (setq mark-active t)
      (switch-to-buffer (current-buffer))
      (let ((failure nil) (last-command nil) (this-command nil))
        (condition-case err
            (execute-kbd-macro (kbd (nth 2 case)))
          (error (setq failure (symbol-name (car err)))))
        (push `((input . ,(vconcat (string-to-list (nth 0 case))))
                (start . ,(nth 1 case)) (keys . ,(nth 2 case))
                (text . ,(vconcat (string-to-list (buffer-string))))
                (point . ,(1- (point))) (mark . ,(1- (mark t)))
                (active . ,(if mark-active t :json-false))
                (ring . ,(vconcat (mapcar (lambda (value) (vconcat (string-to-list value))) kill-ring)))
                (error . ,failure)) results))))
  (princ (json-encode (nreverse results))))
