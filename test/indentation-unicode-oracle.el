(require 'json)
(let ((results nil))
  (dolist (input '("" "abc" "\u00a0x" "\u2003x" "\u3000x" "\u202fx" "\u0085x" "\u000bx" "\u000cx" "\t \u00a0x\n\u2003y" "\U0001f600 \u00a0x"))
    (dotimes (start (1+ (length input)))
      (dolist (mark-state '(unset active inactive))
        (dolist (prefix '("" "C-u " "M-0 " "M-- M-2 "))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char (1+ start))
            (unless (eq mark-state 'unset)
              (set-mark 1)
              (setq mark-active (eq mark-state 'active)))
            (switch-to-buffer (current-buffer))
            (let ((failed nil))
              (condition-case nil
                  (execute-kbd-macro (kbd (concat prefix "M-m")))
                (error (setq failed t)))
              (push `((input . ,(vconcat (string-to-list input))) (start . ,start)
                      (markState . ,(symbol-name mark-state)) (prefix . ,prefix)
                      (text . ,(vconcat (string-to-list (buffer-string))))
                      (point . ,(1- (point))) (mark . ,(and (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false))
                      (failed . ,(if failed t :json-false))) results)))))))
  (princ (json-encode (nreverse results))))
