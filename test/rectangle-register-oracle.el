(require 'json)
(require 'rect)
(require 'register)
(let (results)
  (dolist (delete '(nil t))
    (dolist (reverse '(nil t))
      (with-temp-buffer
        (fundamental-mode)
        (transient-mark-mode 1)
        (insert "abcde\nfghij\nklmno")
        (let ((register-alist nil))
          (goto-char (if reverse 3 10))
          (set-mark (if reverse 10 3))
          (copy-rectangle-to-register ?r (region-beginning) (region-end) delete)
          (let ((after-copy (buffer-string)) (rows (get-register ?r)))
            (goto-char (point-max))
            (insert-register ?r)
            (push `((delete . ,(if delete t :json-false)) (reverse . ,(if reverse t :json-false))
                    (copied . ,after-copy) (rows . ,(vconcat rows))
                    (text . ,(buffer-string)) (point . ,(1- (point)))) results))))))
  (princ (json-encode (nreverse results))))
