(require 'json)
(let ((results nil))
  (dolist (input '("" "abc" "abc\n" "one\nline\n\ntwo\n\nthree" "\n \t\nfirst\n\n\nsecond\n" "a\n\fb\nc\n\f\nd" "a\U0001f600\n\ne\u0301\nx"))
    (dotimes (start (1+ (length input)))
      (dolist (count '(-3 -2 -1 0 1 2 3))
        (with-temp-buffer
          (fundamental-mode)
          (transient-mark-mode 1)
          (insert input)
          (goto-char (1+ start))
          (set-mark (point))
          (setq mark-active t)
          (switch-to-buffer (current-buffer))
          (let ((failure nil) (last-command nil) (this-command nil))
            (condition-case err
                (execute-kbd-macro (kbd (format "M-%s M-}" count)))
              (error (setq failure (symbol-name (car err)))))
            (push `((input . ,(vconcat (string-to-list input)))
                    (start . ,start) (count . ,count) (point . ,(1- (point)))
                    (mark . ,(1- (mark t))) (active . ,(if mark-active t :json-false))
                    (error . ,failure)) results))))))
  (princ (json-encode (nreverse results))))
