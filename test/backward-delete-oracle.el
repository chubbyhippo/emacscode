(require 'json)
(let ((results nil))
  (dolist (case '(("" 0 "DEL") ("" 0 "M-0 DEL")
                  ("abc" 0 "DEL") ("abc" 3 "M-- M-1 DEL")
                  ("abc" 2 "DEL") ("abc" 2 "M-0 DEL")
                  ("abc" 2 "M-2 DEL") ("abc" 2 "M-3 DEL")
                  ("abc" 1 "M-- M-2 DEL") ("abc" 1 "M-- M-3 DEL")
                  ("a\U0001f600b" 2 "DEL") ("a\U0001f600b" 2 "M-2 DEL")
                  ("a\U0001f600b" 1 "M-- M-1 DEL")
                  ("e\u0301b" 2 "DEL") ("a\nb" 2 "DEL")))
    (dolist (mark-state '(unset inactive active))
      (with-temp-buffer
        (fundamental-mode)
        (transient-mark-mode 1)
        (insert (nth 0 case))
        (goto-char (1+ (nth 1 case)))
        (unless (eq mark-state 'unset)
          (set-mark (point-max))
          (setq mark-active (eq mark-state 'active)))
        (switch-to-buffer (current-buffer))
        (let ((failure nil) (last-command nil) (this-command nil)
              (kill-ring '("older")) (kill-ring-yank-pointer nil))
          (setq kill-ring-yank-pointer kill-ring)
          (condition-case err
              (execute-kbd-macro (kbd (nth 2 case)))
            (error (setq failure (symbol-name (car err)))))
          (push `((input . ,(vconcat (string-to-list (nth 0 case))))
                  (start . ,(nth 1 case)) (keys . ,(nth 2 case))
                  (markState . ,(symbol-name mark-state))
                  (text . ,(vconcat (string-to-list (buffer-string))))
                  (point . ,(1- (point)))
                  (mark . ,(when (mark t) (1- (mark t))))
                  (active . ,(if mark-active t :json-false))
                  (ring . ,(vconcat (mapcar (lambda (entry) (vconcat (string-to-list entry))) kill-ring)))
                  (error . ,failure)) results)))))
  (princ (json-encode (nreverse results))))
