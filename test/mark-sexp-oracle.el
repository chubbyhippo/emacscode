(require 'json)
(let (results)
  (dolist (input '("one (two) x" "(a" "a) b" "a\nb" ""))
    (dotimes (start (1+ (length input)))
      (dolist (mark-kind '(unset active-start active-end inactive-start inactive-end))
        (dolist (sequence '(("C-M-@" 1 0 1) ("M-2 C-M-@" 2 1 1)
                            ("M-- C-M-@" -1 1 1) ("M-- M-2 C-M-@" -2 1 1)
                            ("M-0 C-M-@" 0 1 1) ("C-M-@ C-M-@" 1 0 2)))
          (with-temp-buffer
            (fundamental-mode)
            (transient-mark-mode 1)
            (insert input)
            (goto-char (1+ start))
            (setq mark-active nil kill-ring '("sentinel"))
            (unless (eq mark-kind 'unset)
              (set-mark (if (memq mark-kind '(active-end inactive-end)) (point-max) (point-min)))
              (setq mark-active (memq mark-kind '(active-start active-end))))
            (switch-to-buffer (current-buffer))
            (let ((last-command nil) (this-command nil) (failed nil))
              (condition-case nil
                  (execute-kbd-macro (kbd (nth 0 sequence)))
                (error (setq failed t)))
              (push `((input . ,input) (start . ,start) (markKind . ,(symbol-name mark-kind))
                      (count . ,(nth 1 sequence)) (prefixed . ,(if (= (nth 2 sequence) 1) t :json-false))
                      (repeat . ,(nth 3 sequence)) (text . ,(buffer-string))
                      (point . ,(1- (point))) (mark . ,(when (mark t) (1- (mark t))))
                      (active . ,(if mark-active t :json-false))
                      (failed . ,(if failed t :json-false)) (ring . ,(vconcat kill-ring))) results)))))))
  (princ (json-encode (nreverse results))))
