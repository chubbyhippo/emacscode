(require 'json)
(let ((results nil))
  (dolist (case '(("abcd" 1 1 nil) ("abcd" 2 1 nil) ("abcd" 4 1 nil)
                  ("abcd" 0 1 nil) ("abcd" 1 2 nil) ("abcdef" 3 -1 nil)
                  ("abcd" 2 0 0) ("ab\ncd" 2 1 nil) ("ab\ncd" 3 1 nil)))
    (with-temp-buffer
      (fundamental-mode)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (when (nth 3 case) (set-mark (1+ (nth 3 case))))
      (let ((failure nil))
        (condition-case nil (transpose-chars (nth 2 case)) (error (setq failure t)))
        (push `((input . ,(nth 0 case)) (start . ,(nth 1 case)) (count . ,(nth 2 case))
                (mark . ,(nth 3 case)) (text . ,(buffer-string)) (point . ,(1- (point)))
                (failure . ,(if failure t :json-false))) results))))
  (princ (json-encode (nreverse results))))
