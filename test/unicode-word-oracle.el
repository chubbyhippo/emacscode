(require 'json)
(let ((results nil)
      (interprogram-cut-function nil)
      (interprogram-paste-function nil))
  (dolist (case '(("a\U00010400b c" 0 "M-f") ("a\U00010400b c" 3 "M-b")
                  ("\U0001f600\U00010400b!" 0 "M-f") ("\U0001f600\U00010400b!" 3 "M-b")
                  ("\U00010400a \U00010400b" 0 "M-2 M-f") ("\U00010400a \U00010400b" 5 "M-2 M-b")
                  ("a\U00010400b c" 0 "M-d") ("a\U00010400b c" 3 "M-DEL")
                  ("a\U00010400b c" 0 "M-@")))
    (with-temp-buffer
      (fundamental-mode)
      (transient-mark-mode 1)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (setq-local kill-ring nil)
      (switch-to-buffer (current-buffer))
      (let ((failed nil) (last-command nil) (this-command nil))
        (condition-case nil (execute-kbd-macro (kbd (nth 2 case))) (error (setq failed t)))
        (push `((input . ,(vconcat (string-to-list (nth 0 case)))) (start . ,(nth 1 case)) (keys . ,(nth 2 case))
                (text . ,(vconcat (string-to-list (buffer-string)))) (point . ,(1- (point)))
                (mark . ,(and (mark t) (1- (mark t)))) (ring . ,(vconcat (mapcar (lambda (value) (vconcat (string-to-list value))) kill-ring)))
                (failed . ,(if failed t :json-false))) results))))
  (princ (json-encode (nreverse results))))
