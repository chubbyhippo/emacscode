(require 'json)
(let (results)
  (dolist (input '("a\\ b" "ab\\(cd" "\\ foo" "x\\\\y" "(a\\ b) z" "a\\"))
    (dotimes (start (1+ (length input)))
      (dolist (count '(-2 -1 0 1 2))
        (with-temp-buffer
          (fundamental-mode)
          (transient-mark-mode 1)
          (insert input)
          (goto-char (1+ start))
          (set-mark 1)
          (setq mark-active t)
          (switch-to-buffer (current-buffer))
          (let ((failed nil))
            (condition-case nil
                (execute-kbd-macro (kbd (cond ((= count 0) "M-0 C-M-f")
                                               ((= count 1) "C-M-f")
                                               ((= count -1) "C-M-b")
                                               ((= count 2) "M-2 C-M-f")
                                               (t "M-2 C-M-b"))))
              (error (setq failed t)))
            (push `((input . ,input) (start . ,start) (count . ,count)
                    (text . ,(buffer-string)) (point . ,(1- (point)))
                    (mark . ,(and (mark t) (1- (mark t))))
                    (active . ,(if mark-active t :json-false))
                    (failed . ,(if failed t :json-false))) results))))))
  (princ (json-encode (nreverse results))))
