(require 'json)
(let ((results nil))
  (dolist (case '(("alpha beta gamma" 0 "M-@") ("alpha beta gamma" 2 "M-@")
                  ("alpha beta gamma" 0 "M-@ M-@") ("alpha beta gamma" 0 "M-2 M-@")
                  ("alpha beta gamma" 11 "M-- M-2 M-@") ("alpha beta gamma" 6 "M-0 M-@")
                  ("alpha beta gamma" 11 "C-SPC M-b M-@")
                  ("alpha beta gamma" 0 "M-@ M-- M-2 M-@")
                  ("alpha beta gamma" 16 "M-@")))
    (with-temp-buffer
      (fundamental-mode)
      (transient-mark-mode 1)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (switch-to-buffer (current-buffer))
      (condition-case nil (execute-kbd-macro (kbd (nth 2 case))) (error nil))
      (push `((text . ,(nth 0 case)) (start . ,(nth 1 case)) (keys . ,(nth 2 case))
              (point . ,(1- (point))) (mark . ,(if (mark t) (1- (mark t)) :json-null))
              (active . ,(if mark-active t :json-false))) results)))
  (princ (json-encode (nreverse results))))
