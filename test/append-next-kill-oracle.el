(require 'json)
(let ((results nil))
  (dolist (case '(("alpha beta" 0 "C-M-w M-d" ("old"))
                  ("alpha beta" 10 "C-M-w M-DEL" ("old"))
                  ("alpha beta" 0 "C-M-w M-2 M-d" ("old"))
                  ("alpha beta" 0 "C-u C-M-w M-d" ("old"))
                  ("alpha beta" 0 "C-M-w C-f M-d" ("old"))
                  ("alpha beta" 0 "C-M-w C-M-w M-d" ("old"))
                  ("alpha beta" 0 "C-M-w M-d" nil)
                  ("alpha beta" 0 "C-M-w M-0 C-k M-d" ("old"))
                  ("alpha beta" 0 "C-M-w C-SPC C-f M-w" ("old"))
                  ("alpha beta" 0 "C-SPC C-f C-M-w M-w" ("old"))
                  ("alpha beta" 0 "C-SPC C-f C-M-w C-w" ("old"))
                  ("abc\ndef" 0 "C-M-w M-1 C-k C-y" ("old"))))
    (with-temp-buffer
      (fundamental-mode)
      (transient-mark-mode 1)
      (insert (nth 0 case))
      (goto-char (1+ (nth 1 case)))
      (switch-to-buffer (current-buffer))
      (let ((kill-ring (copy-sequence (nth 3 case)))
            (kill-ring-yank-pointer nil) (last-command nil) (this-command nil) (failure nil))
        (condition-case err
            (execute-kbd-macro (kbd (nth 2 case)))
          (error (setq failure (symbol-name (car err)))))
        (push `((input . ,(nth 0 case)) (start . ,(nth 1 case)) (keys . ,(nth 2 case))
                (initialRing . ,(vconcat (nth 3 case))) (text . ,(buffer-string))
                (point . ,(1- (point))) (mark . ,(when (mark t) (1- (mark t))))
                (active . ,(if mark-active t :json-false)) (ring . ,(vconcat kill-ring))
                (error . ,failure)) results))))
  (princ (json-encode (nreverse results))))
