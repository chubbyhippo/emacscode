(require 'json)
(let ((results nil)
      (disabled-command-function nil))
  (dolist (text '("" "abc" "one\ntwo\nthree\nfour\nfive" "a\U0001f600b\n\u732bc\nd"))
    (dolist (initial '(start middle end))
      (dolist (mark-state '(unset inactive active))
        (dolist (prefix '("" "C-u " "C-u C-u " "M-0 " "M-1 " "M-4 " "M-9 " "M-- " "M-- M-2 " "M-2 M-0 "))
          (dolist (key '("M-<" "M->"))
            (with-temp-buffer
              (fundamental-mode)
              (transient-mark-mode 1)
              (insert text)
              (goto-char (+ 1 (cond ((eq initial 'start) 0) ((eq initial 'end) (length text)) (t (/ (length text) 2)))))
              (let ((start (1- (point))))
                (unless (eq mark-state 'unset)
                  (set-mark (point-max))
                  (setq mark-active (eq mark-state 'active)))
                (switch-to-buffer (current-buffer))
                (let ((failed nil) (last-command nil) (this-command nil))
                  (condition-case nil (execute-kbd-macro (kbd (concat prefix key))) (error (setq failed t)))
                  (push `((characters . ,(vconcat (string-to-list text))) (start . ,start) (markState . ,(symbol-name mark-state))
                          (prefix . ,prefix) (key . ,key) (point . ,(1- (point)))
                          (mark . ,(and (mark t) (1- (mark t))))
                          (active . ,(if mark-active t :json-false)) (failed . ,(if failed t :json-false))) results)))))))))
  (princ (json-encode (nreverse results))))
