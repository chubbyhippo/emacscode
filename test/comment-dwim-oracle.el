(require 'json)
(defun comment-dwim-probe (input start)
  (with-temp-buffer
    (fundamental-mode)
    (transient-mark-mode 1)
    (setq-local comment-start "//")
    (setq-local comment-end "")
    (setq-local comment-use-syntax nil)
    (insert input)
    (goto-char (1+ start))
    (switch-to-buffer (current-buffer))
    (let ((failure nil) (last-command nil) (this-command nil))
      (condition-case err
          (execute-kbd-macro (kbd "M-;"))
        (error (setq failure (symbol-name (car err)))))
      `((input . ,input) (start . ,start) (text . ,(buffer-string))
        (point . ,(1- (point))) (error . ,failure)))))
(defun comment-dwim-region-probe (input mark point &optional keys)
  (with-temp-buffer
    (fundamental-mode)
    (transient-mark-mode 1)
    (setq-local comment-start "//")
    (setq-local comment-end "")
    (setq-local comment-use-syntax nil)
    (insert input)
    (set-mark (1+ mark))
    (goto-char (1+ point))
    (setq mark-active t)
    (switch-to-buffer (current-buffer))
    (let ((failure nil) (last-command nil) (this-command nil))
      (condition-case err
          (execute-kbd-macro (kbd (or keys "M-;")))
        (error (setq failure (symbol-name (car err)))))
      `((input . ,input) (mark . ,mark) (point-arg . ,point) (keys . ,keys) (text . ,(buffer-string))
        (point . ,(1- (point))) (mark2 . ,(when (mark t) (1- (mark t))))
        (active . ,(if mark-active t :json-false)) (error . ,failure)))))
(defun comment-dwim-prefix-probe (input start keys)
  (with-temp-buffer
    (fundamental-mode)
    (transient-mark-mode 1)
    (setq-local comment-start "//")
    (setq-local comment-end "")
    (setq-local comment-use-syntax nil)
    (insert input)
    (goto-char (1+ start))
    (switch-to-buffer (current-buffer))
    (let ((kill-ring nil) (kill-ring-yank-pointer nil)
          (failure nil) (last-command nil) (this-command nil))
      (condition-case err
          (execute-kbd-macro (kbd keys))
        (error (setq failure (symbol-name (car err)))))
      `((input . ,input) (start . ,start) (keys . ,keys)
        (text . ,(buffer-string)) (point . ,(1- (point)))
        (mark . ,(when (mark t) (1- (mark t))))
        (active . ,(if mark-active t :json-false))
        (ring . ,(vconcat kill-ring)) (error . ,failure)))))
(let ((point-results nil) (region-results nil) (prefix-results nil) (region-prefix-results nil))
  (dolist (input '("" "   " "foo();" "  foo();" "foo();   "
                    "foo(); // existing" "foo();//existing" "// foo();"
                    "  // foo();" "\t// foo();" "foo();\nbar();\nbaz();"
                    "  foo();\n    bar();" "foo();\t\t\t\t\t// c"))
    (dotimes (start (1+ (length input)))
      (push (comment-dwim-probe input start) point-results)))
  (dolist (case '(("foo();\nbar();" 0 13)
                   ("foo();\nbar();\nbaz();" 0 20)
                   ("// foo();\n// bar();" 0 19)
                   ("foo();\n// bar();" 0 16)
                   ("  foo();\n  bar();" 0 17)
                   ("foo();\n    bar();" 0 17)
                   ("    foo();\nbar();" 0 17)
                   ("foo();\n\nbar();" 0 14)
                   ("foo();" 0 6)
                   ("foo();" 3 3)
                   ("foo();\nbar();\n" 0 14)
                   ("foo\nbar" 0 4)
                   ("foo\nbar" 4 0)
                   ("foo\nbar" 7 0)
                   ("// foo\n// bar" 0 7)
                   ("// foo\n// bar" 7 0)))
    (push (apply #'comment-dwim-region-probe case) region-results))
  (dolist (case '(("foo\nbar" 0 7) ("foo\nbar" 7 0)
                   ("// foo\n// bar" 0 13) ("// foo\n// bar" 13 0)
                   ("foo\nbar" 0 4) ("foo\nbar" 4 0)
                   ("// foo\n// bar" 0 7) ("// foo\n// bar" 7 0)
                   ("  foo\n  bar" 0 11) ("// foo\nbar" 0 10)
                   ("/// foo\n/// bar" 0 15) ("//// foo\n//// bar" 0 17)
                   ("///foo\n////bar" 0 14)))
    (dolist (keys '("M-0 M-;" "M-1 M-;" "M-2 M-;" "M-- M-1 M-;" "C-u M-;"))
      (push (apply #'comment-dwim-region-probe (append case (list keys))) region-prefix-results)))
  (dolist (input '("code // one\nnext // two\nlast // three" "// a\n// b\n// c" "code\nplain" "a // x\nplain\nb // y" "  // x\n" "foo();//x" "foo;   //x" "foo; //" "//" "   " ""))
    (dotimes (start (1+ (length input)))
      (dolist (keys '("C-u M-;" "M-0 M-;" "M-1 M-;" "M-2 M-;" "M-- M-1 M-;" "M-- M-2 M-;"))
        (push (comment-dwim-prefix-probe input start keys) prefix-results))))
  (princ (json-encode `((point . ,(nreverse point-results))
                        (region . ,(nreverse region-results))
                        (region-prefix . ,(nreverse region-prefix-results))
                        (prefix . ,(nreverse prefix-results))))))
