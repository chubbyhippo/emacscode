{
  "name": "emacscode",
  "displayName": "emacscode",
  "description": "Emacs-style editing for VS Code",
  "version": "0.1.0",
  "publisher": "emacscode",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .vscode-test.mts configure-manifest.ts src scripts test",
    "compile:tools": "tsc -p tsconfig.tools.json",
    "setup:emacs": "npm run compile:tools && node .build/scripts/setup-emacs.js",
    "precompile": "npm run setup:emacs",
    "compile": "tsc -p ./",
    "inventory": "npm run compile:tools && node .build/test/inventory.js",
    "configure:manifest": "npm run compile:tools && node .build/configure-manifest.js",
    "build:vsix": "npm run compile && npm exec --yes --package @vscode/vsce@4.1.1 -- vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "test:core": "npm run compile && node .build/test/inventory.js --check && node .build/test/inventory-reviews.test.js && cucumber-js --require .build/test/steps/**/*.js test/features/**/*.feature && node .build/test/search-decorations.js && node .build/test/setup-emacs.js",
    "test:extension": "npm run compile && vscode-test --config .build/.vscode-test.mjs",
    "test:oracle": "npm run compile && node .build/scripts/run-oracles.js",
    "test": "npm run test:core"
  },
  "contributes": {
    "configurationDefaults": {
      "editor.cursorStyle": "block"
    },
    "configuration": {
      "title": "emacscode",
      "properties": {
        "emacscode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Emacs-style editor keybindings."
        },
        "emacscode.killRingSize": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum in-memory kill ring entries."
        }
      }
    },
    "commands": [
